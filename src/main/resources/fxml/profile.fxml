<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns:fx="http://javafx.com/fxml/1" spacing="28" styleClass="pane-root"
  stylesheets="@../styles/styles.css"
  xmlns="http://javafx.com/javafx/21"
  fx:controller="com.tyrkanych.controller.ProfileController">
  <VBox prefWidth="280" spacing="20">
    <VBox alignment="CENTER" spacing="16" styleClass="card">
      <HBox alignment="CENTER" spacing="8">
        <Label styleClass="badge" fx:id="profileAge"/>
        <Label styleClass="badge" fx:id="profileGender"/>
      </HBox>
      <Label styleClass="label-muted" fx:id="profileEmail"/>
      <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2D2550;"
        fx:id="profileName"/>
      <Label styleClass="label-muted" fx:id="profileCity"/>
      <StackPane
        style="-fx-background-color: linear-gradient(135deg,#C4B4E8,#9B7DD4); -fx-background-radius: 50; -fx-min-width: 88; -fx-min-height: 88; -fx-max-width: 88; -fx-max-height: 88;"
        alignment="CENTER">
        <Label style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: white;"
          fx:id="profileInitial"/>
      </StackPane>
    </VBox>
    <VBox spacing="12" styleClass="card">
      <HBox alignment="CENTER" spacing="0">
        <Separator orientation="VERTICAL"/>
        <Separator orientation="VERTICAL"/>
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
          <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #C44569;"
            fx:id="statsMatches"/>
          <Label styleClass="label-muted" text="Збіги"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
          <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #7C5CBF;"
            fx:id="statsLikes"/>
          <Label styleClass="label-muted" text="Лайки"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
          <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2D8653;"
            fx:id="statsMessages"/>
          <Label styleClass="label-muted" text="Чати"/>
        </VBox>
      </HBox>
      <Label style="-fx-padding: 0;" styleClass="settings-section-title" text="СТАТИСТИКА"/>
    </VBox>
  </VBox>
  <VBox HBox.hgrow="ALWAYS" spacing="20">
    <Label styleClass="label-title" text="Редагувати профіль"/>
    <VBox spacing="16" styleClass="card">
      <HBox spacing="12">
        <Button onAction="#saveProfile" styleClass="btn-primary" text="✓  Зберегти"/>
        <Button onAction="#resetProfile" styleClass="btn-secondary" text="Скинути"/>
      </HBox>
      <Label styleClass="field-label" text="МІСТО"/>
      <Label styleClass="field-label" text="ПРО СЕБЕ"/>
      <Label styleClass="field-label" text="ІМ'Я"/>
      <Label wrapText="true" fx:id="saveStatus"/>
      <TextArea maxWidth="Infinity" prefRowCount="4" promptText="Розкажіть про себе..."
        fx:id="editBio"/>
      <TextField maxWidth="Infinity" promptText="Ваше ім'я" fx:id="editName"/>
      <TextField maxWidth="Infinity" promptText="Ваше місто" fx:id="editCity"/>
    </VBox>
  </VBox>
</HBox>