<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="login-pane"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.tyrkanych.controller.LoginController">

  <VBox alignment="CENTER" spacing="0">

    <!-- Логотип -->
    <HBox alignment="CENTER" spacing="6">
      <VBox.margin><Insets bottom="32"/></VBox.margin>
      <Label styleClass="login-logo-heart" text="♥"/>
      <Label styleClass="login-logo" text="HeartSync"/>
    </HBox>

    <!-- Карточка -->
    <VBox styleClass="login-card" spacing="16" alignment="CENTER">

      <Label text="З поверненням ✦"
        style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2D2550;"/>
      <Label text="Увійдіть щоб продовжити"
        styleClass="label-muted" style="-fx-padding: 0 0 12 0;"/>

      <VBox spacing="4" maxWidth="Infinity">
        <Label text="EMAIL" styleClass="field-label"/>
        <TextField fx:id="emailField"
          promptText="your@email.com"
          maxWidth="Infinity"/>
      </VBox>

      <VBox spacing="4" maxWidth="Infinity">
        <Label text="ПАРОЛЬ" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"
          promptText="••••••••"
          maxWidth="Infinity"/>
      </VBox>

      <Label fx:id="statusLabel" styleClass="status-error"
        wrapText="true" maxWidth="360"/>

      <Button text="Увійти →" styleClass="btn-primary"
        maxWidth="Infinity" onAction="#handleLogin"/>

      <HBox alignment="CENTER" spacing="6">
        <Label text="Немає акаунту?" styleClass="label-muted"/>
        <Label text="Зареєструватись"
          style="-fx-cursor: hand; -fx-font-size: 14px; -fx-text-fill: #7C5CBF; -fx-font-weight: bold;"
          onMouseClicked="#goToRegistration"/>
      </HBox>

    </VBox>
  </VBox>
</StackPane>