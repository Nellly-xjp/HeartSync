<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="login-pane"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.tyrkanych.controller.LoginController">

  <VBox alignment="CENTER" spacing="0">

    <HBox alignment="CENTER" spacing="6">
      <VBox.margin><Insets bottom="32"/></VBox.margin>
      <Label styleClass="login-logo-heart" text="♥"/>
      <Label styleClass="login-logo" text="HeartSync"/>
    </HBox>

    <VBox styleClass="login-card" spacing="16" alignment="CENTER">

      <Label fx:id="labelTitle"
        style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2D2550;"/>
      <Label fx:id="labelSubtitle"
        styleClass="label-muted" style="-fx-padding: 0 0 12 0;"/>

      <VBox spacing="4" maxWidth="Infinity">
        <Label fx:id="labelEmail" styleClass="field-label"/>
        <TextField fx:id="emailField"
          promptText="your@email.com"
          maxWidth="Infinity"/>
      </VBox>

      <VBox spacing="4" maxWidth="Infinity">
        <Label fx:id="labelPassword" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"
          promptText="••••••••"
          maxWidth="Infinity"/>
      </VBox>

      <Label fx:id="statusLabel" styleClass="status-error"
        wrapText="true" maxWidth="360"/>

      <Button fx:id="btnLogin" styleClass="btn-primary"
        maxWidth="Infinity" onAction="#handleLogin"/>

      <HBox alignment="CENTER" spacing="6">
        <Label fx:id="labelNoAccount" styleClass="label-muted"/>
        <Label fx:id="labelRegister"
          style="-fx-cursor: hand; -fx-font-size: 14px; -fx-text-fill: #7C5CBF; -fx-font-weight: bold;"
          onMouseClicked="#goToRegistration"/>
      </HBox>

    </VBox>
  </VBox>
</StackPane>