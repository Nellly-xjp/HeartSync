<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" styleClass="login-pane"

  xmlns="http://javafx.com/javafx/21"
  fx:controller="com.tyrkanych.controller.RegistrationController">

  <ScrollPane style="-fx-background-color: transparent; -fx-border-color: transparent;"
    fitToWidth="true">
    <VBox style="-fx-padding: 40 0;" alignment="CENTER" spacing="0">

      <HBox alignment="CENTER" spacing="6">
        <Label styleClass="login-logo-heart" text="♥"/>
        <Label styleClass="login-logo" text="HeartSync"/>
        <VBox.margin>
          <Insets bottom="24"/>
        </VBox.margin>
      </HBox>

      <!-- КРОК 1 -->
      <StackPane fx:id="step1Pane">
        <VBox alignment="CENTER" spacing="16" styleClass="login-card">
          <Button maxWidth="Infinity" onAction="#handleSendCode"
            styleClass="btn-primary" text="Надіслати код →"/>
          <HBox alignment="CENTER" spacing="8">
            <Label styleClass="badge" text="① Email"/>
            <Label styleClass="label-muted" text="——"/>
            <Label styleClass="badge-pink badge" text="② Код"/>
            <Label styleClass="label-muted" text="——"/>
            <Label styleClass="badge-pink badge" text="③ Профіль"/>
          </HBox>
          <HBox alignment="CENTER" spacing="6">
            <Label styleClass="label-muted" text="Вже є акаунт?"/>
            <Label style="-fx-cursor: hand; -fx-text-fill: #7C5CBF; -fx-font-weight: bold;"
              onMouseClicked="#goToLogin"
              text="Увійти"/>
          </HBox>

          <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2D2550;"
            text="Створити акаунт"/>
          <Label maxWidth="360" wrapText="true" fx:id="step1Status"/>
          <Label styleClass="label-muted" text="Крок 1 з 3 — Дані для входу"/>

          <VBox maxWidth="Infinity" spacing="4">
            <Label styleClass="field-label" text="EMAIL"/>
            <TextField maxWidth="Infinity" promptText="your@email.com" fx:id="emailField"/>
          </VBox>
          <VBox maxWidth="Infinity" spacing="4">
            <Label styleClass="field-label" text="ПАРОЛЬ"/>
            <PasswordField maxWidth="Infinity" promptText="мінімум 8 символів"
              fx:id="passwordField"/>
          </VBox>

          <VBox maxWidth="Infinity" spacing="4">
            <Label styleClass="field-label" text="ПІДТВЕРДІТЬ ПАРОЛЬ"/>
            <PasswordField maxWidth="Infinity" promptText="повторіть пароль"
              fx:id="confirmPasswordField"/>
          </VBox>
        </VBox>
      </StackPane>

      <!-- КРОК 2 -->
      <StackPane managed="false" visible="false" fx:id="step2Pane">
        <VBox alignment="CENTER" spacing="16" styleClass="login-card">
          <Button maxWidth="Infinity" onAction="#handleVerifyCode"
            styleClass="btn-primary" text="Підтвердити ✓"/>
          <HBox alignment="CENTER" spacing="8">
            <Label styleClass="badge-green badge" text="① Email"/>
            <Label styleClass="label-muted" text="——"/>
            <Label styleClass="badge" text="② Код"/>
            <Label styleClass="label-muted" text="——"/>
            <Label styleClass="badge-pink badge" text="③ Профіль"/>
          </HBox>
          <Label styleClass="label-muted" fx:id="codeEmailLabel"/>
          <Label styleClass="label-muted" text="Крок 2 з 3 — Введіть 6-значний код"/>

          <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2D2550;"
            text="Перевірте пошту 📬"/>

          <Label maxWidth="360" wrapText="true" fx:id="step2Status"/>
          <Label style="-fx-cursor: hand; -fx-text-fill: #7C5CBF;"
            onMouseClicked="#handleResendCode"
            text="Надіслати код повторно"/>
          <VBox maxWidth="Infinity" spacing="4">
            <Label styleClass="field-label" text="КОД ПІДТВЕРДЖЕННЯ"/>
            <TextField style="-fx-font-size: 20px; -fx-alignment: center;" maxWidth="Infinity"
              promptText="000000"
              fx:id="codeField"/>
          </VBox>
        </VBox>
      </StackPane>

      <!-- КРОК 3 -->
      <StackPane managed="false" visible="false" fx:id="step3Pane">
        <VBox style="-fx-max-width: 560; -fx-min-width: 560;" alignment="CENTER" spacing="16"
          styleClass="login-card">
          <Button maxWidth="Infinity" onAction="#handleRegister"
            styleClass="btn-primary" text="Створити акаунт ♥"/>
          <HBox alignment="CENTER" spacing="8">
            <Label styleClass="badge-green badge" text="① Email"/>
            <Label styleClass="label-muted" text="——"/>
            <Label styleClass="badge-green badge" text="② Код"/>
            <Label styleClass="label-muted" text="——"/>
            <Label styleClass="badge" text="③ Профіль"/>
          </HBox>
          <HBox spacing="16">
            <VBox HBox.hgrow="ALWAYS" spacing="4">
              <ComboBox maxWidth="Infinity" promptText="Оберіть" fx:id="genderComboBox"/>
              <Label styleClass="field-label" text="СТАТЬ"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="4">
              <DatePicker maxWidth="Infinity" fx:id="birthDatePicker"/>
              <Label styleClass="field-label" text="ДАТА НАРОДЖЕННЯ"/>
            </VBox>
          </HBox>

          <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2D2550;"
            text="Розкажи про себе ✦"/>

          <Label styleClass="label-muted" text="Крок 3 з 3 — Заповніть профіль"/>

          <Label maxWidth="400" wrapText="true" fx:id="step3Status"/>

          <VBox maxWidth="Infinity" spacing="4">
            <Label styleClass="field-label" text="ЯК ТЕБЕ ЗВАТИ?"/>
            <TextField maxWidth="Infinity" promptText="Ваше ім'я" fx:id="nameField"/>
          </VBox>

          <VBox maxWidth="Infinity" spacing="4">
            <Label styleClass="field-label" text="МІСТО"/>
            <TextField maxWidth="Infinity" promptText="Де ти живеш?" fx:id="cityField"/>
          </VBox>

          <VBox maxWidth="Infinity" spacing="4">
            <Label styleClass="field-label" text="ПРО СЕБЕ"/>
            <TextArea maxWidth="Infinity" prefRowCount="3"
              promptText="Розкажи про себе..." fx:id="bioArea"/>
          </VBox>
          <VBox maxWidth="Infinity" spacing="8">
            <FlowPane hgap="8" vgap="8" fx:id="interestsPane"/>
            <Label styleClass="field-label" text="ІНТЕРЕСИ (оберіть до 5)"/>
          </VBox>
        </VBox>
      </StackPane>

    </VBox>
  </ScrollPane>
</StackPane>