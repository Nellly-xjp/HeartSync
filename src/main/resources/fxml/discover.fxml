<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="24" styleClass="pane-root"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.tyrkanych.controller.DiscoverController">

  <HBox alignment="CENTER_LEFT" spacing="12">
    <VBox HBox.hgrow="ALWAYS" spacing="2">
      <Label styleClass="label-title" text="Пошук"/>
      <Label styleClass="label-muted" text="Люди з твого міста"/>
    </VBox>
    <ComboBox fx:id="genderFilter" promptText="Стать" prefWidth="110"/>
    <TextField fx:id="minAge" promptText="Вік від" prefWidth="80"/>
    <TextField fx:id="maxAge" promptText="Вік до" prefWidth="80"/>
    <Button text="Застосувати" styleClass="btn-secondary"
      onAction="#applyFilters"/>
  </HBox>

  <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
    <VBox styleClass="match-card" spacing="0" alignment="TOP_CENTER">

      <StackPane alignment="CENTER"
        style="-fx-min-width: 360; -fx-pref-height: 240;
               -fx-max-height: 240; -fx-background-color: #C4B4E8;
               -fx-background-radius: 28 28 0 0;">
        <ImageView fx:id="cardPhoto"
          fitWidth="360" fitHeight="240"
          preserveRatio="false" visible="false"/>
        <Label fx:id="profileEmoji" text="?"
          style="-fx-font-size: 80px; -fx-text-fill: white;
                 -fx-font-weight: bold;"/>
      </StackPane>

      <VBox spacing="4" alignment="CENTER"
        style="-fx-padding: 16 20 0 20;">
        <Label fx:id="compatibilityBadge" styleClass="badge"
          style="-fx-padding: 4 14;">
          <VBox.margin><Insets bottom="8"/></VBox.margin>
        </Label>
        <Label fx:id="cardName" styleClass="match-card-name"
          wrapText="true" style="-fx-alignment: center;"/>
        <HBox alignment="CENTER" spacing="8"
          style="-fx-padding: 6 0 0 0;">
          <Label fx:id="cardAge" styleClass="label-muted"/>
          <Label text="·" styleClass="label-muted"/>
          <Label fx:id="cardCity" styleClass="match-card-city"/>
        </HBox>
        <Label fx:id="cardBio" styleClass="label-muted"
          wrapText="true"
          style="-fx-padding: 8 0; -fx-alignment: center;"/>
        <HBox alignment="CENTER" spacing="8"
          style="-fx-padding: 0 0 16 0;">
          <Label fx:id="interest1" styleClass="badge"/>
          <Label fx:id="interest2" styleClass="badge"/>
          <Label fx:id="interest3" styleClass="badge"/>
        </HBox>
      </VBox>

      <Region VBox.vgrow="ALWAYS"/>

      <HBox alignment="CENTER" spacing="16"
        style="-fx-padding: 0 24 28 24;">
        <Button text="✕" styleClass="btn-danger"
          prefWidth="56" prefHeight="56"
          style="-fx-font-size: 20px; -fx-background-radius: 50;"
          onAction="#handlePass"/>
        <Button text="★" prefWidth="48" prefHeight="48"
          style="-fx-font-size: 16px; -fx-background-radius: 50;
                 -fx-background-color: #F5A623; -fx-text-fill: white;
                 -fx-cursor: hand;"
          onAction="#handleSuperLike"/>
        <Button text="♥" styleClass="btn-primary"
          prefWidth="56" prefHeight="56"
          style="-fx-font-size: 20px; -fx-background-radius: 50;"
          onAction="#handleLike"/>
      </HBox>
    </VBox>
  </HBox>

  <Label fx:id="statusLabel" styleClass="status-info"
    style="-fx-alignment: center;"/>

</VBox>