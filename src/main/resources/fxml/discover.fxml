<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
  style="-fx-background-color: #0D0A1A;"
  spacing="24"
  stylesheets="@/styles/styles.css" fx:controller="com.tyrkanych.controller.DiscoverController">

  <HBox alignment="CENTER_LEFT">
    <VBox spacing="4">
      <Label styleClass="label-title" text="🔥 Стрічка знайомств"/>
      <Label styleClass="label-subtitle"
        text="Хто сьогодні зустрінеться на твоєму шляху?"/>
    </VBox>
  </HBox>

  <HBox VBox.vgrow="ALWAYS" alignment="TOP_CENTER" spacing="32">

    <!-- Картка профілю -->
    <VBox alignment="CENTER" spacing="0" styleClass="match-card">
      <StackPane style="-fx-background-color: linear-gradient(135deg,#241F45,#1C1836);
                              -fx-background-radius: 24 24 0 0;
                              -fx-min-height: 280; -fx-max-height: 280;"
        VBox.vgrow="ALWAYS">
        <Label style="-fx-font-size: 80px; -fx-opacity: 0.3;" text="👤"
          fx:id="profileEmoji"/>
        <VBox style="-fx-padding: 16;" alignment="TOP_RIGHT">
          <HBox style="-fx-background-color: #FF6B2B;
                                 -fx-background-radius: 20; -fx-padding: 6 12;">
            <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="0%"
              fx:id="compatibilityBadge"/>
          </HBox>
        </VBox>
      </StackPane>

      <VBox style="-fx-background-color: linear-gradient(180deg,transparent,#0D0A1Aee);
                         -fx-background-radius: 0 0 24 24; -fx-padding: 20;"
        maxWidth="Infinity" spacing="8">
        <HBox alignment="CENTER_LEFT" spacing="10">
          <Label styleClass="match-card-name" text="Завантаження..."
            fx:id="cardName"/>
          <Label style="-fx-background-color: #7B3FE422; -fx-text-fill: #9B6EF5;
                                  -fx-background-radius: 8; -fx-padding: 3 8;" text=""
            fx:id="cardAge"/>
        </HBox>
        <HBox style="-fx-padding: 4 0 0 0;" spacing="6">
          <Label styleClass="badge" text="" fx:id="interest1"/>
          <Label styleClass="badge" text="" fx:id="interest2"/>
          <Label styleClass="badge" text="" fx:id="interest3"/>
        </HBox>
        <Label maxWidth="290" styleClass="label-muted" text=""
          wrapText="true" fx:id="cardBio"/>
        <Label styleClass="match-card-city" text="" fx:id="cardCity"/>
      </VBox>
    </VBox>

    <!-- Бокова панель: кнопки + фільтри -->
    <VBox style="-fx-min-width: 260;" alignment="TOP_CENTER" spacing="20">

      <Label alignment="CENTER" styleClass="label-muted" text=""
        wrapText="true" fx:id="statusLabel"/>

      <VBox spacing="14" styleClass="card">
        <Button maxWidth="Infinity" onAction="#applyFilters"
          styleClass="btn-violet" text="Застосувати"/>
        <Label style="-fx-text-fill: #EDE8FF; -fx-font-weight: bold; -fx-font-size: 14px;"
          text="Фільтри"/>
        <VBox spacing="4">
          <Label styleClass="field-label" text="МІСТО"/>
          <TextField maxWidth="Infinity" promptText="Будь-яке"
            styleClass="text-field" fx:id="cityFilter"/>
        </VBox>
        <VBox spacing="4">
          <HBox alignment="CENTER_LEFT" spacing="8">
            <Label styleClass="label-muted" text="—"/>
            <TextField prefWidth="80" promptText="18"
              styleClass="text-field" fx:id="minAge"/>
            <TextField prefWidth="80" promptText="99"
              styleClass="text-field" fx:id="maxAge"/>
          </HBox>
          <Label styleClass="field-label" text="ВІК"/>
        </VBox>
        <VBox spacing="4">
          <ComboBox maxWidth="Infinity" promptText="Всі"
            styleClass="combo-box" fx:id="genderFilter"/>
          <Label styleClass="field-label" text="СТАТЬ"/>
        </VBox>
      </VBox>

      <VBox spacing="16" styleClass="card">
        <Button style="-fx-font-size: 16px; -fx-padding: 14 0;" maxWidth="Infinity"
          onAction="#handleLike" styleClass="btn-primary"
          text="♥  Лайк"/>
        <Button maxWidth="Infinity" onAction="#handlePass"
          styleClass="btn-secondary" text="✕  Пропустити"/>
        <Button maxWidth="Infinity" onAction="#handleSuperLike"
          styleClass="btn-violet" text="⭐  Супер-лайк"/>
        <Label style="-fx-text-fill: #EDE8FF; -fx-font-weight: bold; -fx-font-size: 14px;"
          text="Твій вибір"/>
      </VBox>
    </VBox>
  </HBox>
</VBox>