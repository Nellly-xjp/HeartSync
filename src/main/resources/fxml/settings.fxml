<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.tyrkanych.controller.SettingsController"
  style="-fx-background-color: transparent; -fx-border-color: transparent;">

  <VBox spacing="24" styleClass="pane-root"
    style="-fx-padding: 0 0 24 0;">

    <Label styleClass="label-title" text="Налаштування"/>
    <Label wrapText="true" fx:id="settingsStatus"/>

    <!-- Тема оформлення -->
    <VBox spacing="16" styleClass="card">
      <Label style="-fx-padding: 0;" styleClass="settings-section-title"
        text="ТЕМА ОФОРМЛЕННЯ"/>
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Button onAction="#setLightTheme" styleClass="btn-secondary"
          text="Світла" fx:id="btnLightTheme"/>
        <Button onAction="#setDarkTheme" styleClass="btn-secondary"
          text="Темна" fx:id="btnDarkTheme"/>
      </HBox>
      <Label style="-fx-font-size: 11px;" styleClass="label-muted" fx:id="themeStatus"/>
    </VBox>

    <!-- Уподобання -->
    <VBox spacing="16" styleClass="card">
      <Label style="-fx-padding: 0;" styleClass="settings-section-title"
        text="УПОДОБАННЯ ПОШУКУ"/>

      <HBox spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
          <Label styleClass="field-label" text="СТАТЬ"/>
          <ComboBox fx:id="prefGender" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
          <Label styleClass="field-label" text="ВІК ВІД"/>
          <TextField promptText="18" fx:id="prefMinAge" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
          <Label styleClass="field-label" text="ВІК ДО"/>
          <TextField promptText="60" fx:id="prefMaxAge" maxWidth="Infinity"/>
        </VBox>
      </HBox>

      <VBox spacing="4">
        <Label styleClass="field-label" text="МІСТО"/>
        <TextField maxWidth="Infinity" promptText="Будь-яке місто" fx:id="prefCity"/>
      </VBox>

      <Button onAction="#savePreferences" styleClass="btn-primary"
        text="Зберегти уподобання"/>
    </VBox>

    <!-- Сповіщення -->
    <VBox spacing="16" styleClass="card">
      <Label style="-fx-padding: 0;" styleClass="settings-section-title"
        text="СПОВІЩЕННЯ"/>
      <CheckBox text="Нові повідомлення" fx:id="notifyMessages"/>
      <CheckBox text="Нові збіги" fx:id="notifyMatches"/>
      <Button onAction="#savePrivacy" styleClass="btn-secondary" text="Зберегти"/>
    </VBox>

    <!-- Небезпечна зона -->
    <VBox spacing="12" styleClass="card">
      <Label style="-fx-padding: 0; -fx-text-fill: #C44569;"
        styleClass="settings-section-title" text="НЕБЕЗПЕЧНА ЗОНА"/>
      <Label styleClass="label-muted" text="Видалення акаунту — незворотня дія"/>
      <Button onAction="#deleteAccount" styleClass="btn-danger" text="Видалити акаунт"/>
    </VBox>

  </VBox>
</ScrollPane>