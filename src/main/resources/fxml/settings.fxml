<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.tyrkanych.controller.SettingsController"
  style="-fx-background-color: transparent; -fx-border-color: transparent;">

  <VBox spacing="24" styleClass="pane-root"
    style="-fx-padding: 0 0 24 0;">

    <Label styleClass="label-title" fx:id="labelSettingsTitle"/>
    <Label wrapText="true" fx:id="settingsStatus"/>

    <!-- Тема -->
    <VBox spacing="16" styleClass="card">
      <Label style="-fx-padding: 0;" styleClass="settings-section-title"
        fx:id="labelThemeSection"/>
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Button onAction="#setLightTheme" styleClass="btn-secondary"
          fx:id="btnLightTheme"/>
        <Button onAction="#setDarkTheme" styleClass="btn-secondary"
          fx:id="btnDarkTheme"/>
      </HBox>
      <Label style="-fx-font-size: 11px;" styleClass="label-muted" fx:id="themeStatus"/>
    </VBox>

    <!-- Мова -->
    <VBox spacing="16" styleClass="card">
      <Label style="-fx-padding: 0;" styleClass="settings-section-title"
        fx:id="labelLangSection"/>
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Button onAction="#setLangUk" styleClass="btn-secondary"
          fx:id="btnLangUk"/>
        <Button onAction="#setLangEn" styleClass="btn-secondary"
          fx:id="btnLangEn"/>
      </HBox>
    </VBox>

    <!-- Уподобання -->
    <VBox spacing="16" styleClass="card">
      <Label style="-fx-padding: 0;" styleClass="settings-section-title"
        fx:id="labelPrefsSection"/>
      <HBox spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
          <Label styleClass="field-label" fx:id="labelGender"/>
          <ComboBox fx:id="prefGender" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
          <Label styleClass="field-label" fx:id="labelAgeFrom"/>
          <TextField promptText="18" fx:id="prefMinAge" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
          <Label styleClass="field-label" fx:id="labelAgeTo"/>
          <TextField promptText="60" fx:id="prefMaxAge" maxWidth="Infinity"/>
        </VBox>
      </HBox>
      <VBox spacing="4">
        <Label styleClass="field-label" fx:id="labelCity"/>
        <TextField maxWidth="Infinity" promptText="Будь-яке місто" fx:id="prefCity"/>
      </VBox>
      <Button onAction="#savePreferences" styleClass="btn-primary"
        fx:id="btnSavePrefs"/>
    </VBox>

    <!-- Сповіщення -->
    <VBox spacing="16" styleClass="card">
      <Label style="-fx-padding: 0;" styleClass="settings-section-title"
        fx:id="labelNotifications"/>
      <CheckBox fx:id="checkNotifyMessages"/>
      <CheckBox fx:id="checkNotifyMatches"/>
      <Button onAction="#savePrivacy" styleClass="btn-secondary"
        fx:id="btnSaveNotifications"/>
    </VBox>

    <!-- Небезпечна зона -->
    <VBox spacing="12" styleClass="card">
      <Label style="-fx-padding: 0; -fx-text-fill: #C44569;"
        styleClass="settings-section-title" fx:id="labelDanger"/>
      <Label styleClass="label-muted" fx:id="labelDeleteWarning"/>
      <Button onAction="#deleteAccount" styleClass="btn-danger"
        fx:id="btnDeleteAccount"/>
    </VBox>

  </VBox>
</ScrollPane>