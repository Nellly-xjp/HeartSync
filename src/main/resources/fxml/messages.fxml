<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="0" styleClass="pane-root"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.tyrkanych.controller.MessagesController">

  <VBox prefWidth="270" spacing="12" styleClass="chat-sidebar">
    <Label fx:id="labelTitle" styleClass="label-title"
      style="-fx-padding: 0 16 8 16;"/>
    <TextField fx:id="chatSearch" VBox.vgrow="NEVER"
      style="-fx-margin: 0 16 0 16;"/>
    <ListView fx:id="chatList" VBox.vgrow="ALWAYS"/>
  </VBox>

  <VBox HBox.hgrow="ALWAYS" spacing="0">
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="chat-header">
      <StackPane alignment="CENTER" styleClass="avatar-circle">
        <Label fx:id="chatInitial" styleClass="avatar-initial"/>
      </StackPane>
      <VBox spacing="2">
        <Label fx:id="chatPartnerName" styleClass="chat-partner-name"/>
        <Label fx:id="chatPartnerStatus" styleClass="label-muted"/>
      </VBox>
    </HBox>

    <ScrollPane fx:id="chatScrollPane" VBox.vgrow="ALWAYS"
      fitToWidth="true" styleClass="chat-scroll">
      <VBox fx:id="messagesContainer" spacing="8"
        styleClass="chat-messages-container">
        <Label fx:id="labelPlaceholder" styleClass="label-muted"
          style="-fx-padding: 40 0;" maxWidth="Infinity"/>
      </VBox>
    </ScrollPane>

    <HBox alignment="CENTER" spacing="10" styleClass="chat-input-area">
      <TextField fx:id="messageInput" HBox.hgrow="ALWAYS"
        onAction="#sendMessage"/>
      <Button text="→" styleClass="btn-primary" onAction="#sendMessage"
        style="-fx-font-size: 18px; -fx-min-width: 44; -fx-min-height: 44;
               -fx-background-radius: 50; -fx-cursor: hand;"/>
    </HBox>
  </VBox>
</HBox>