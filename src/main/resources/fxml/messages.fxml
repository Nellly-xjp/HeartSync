<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns:fx="http://javafx.com/fxml/1" spacing="0" styleClass="pane-root"
  stylesheets="@../styles/styles.css"
  xmlns="http://javafx.com/javafx/21"
  fx:controller="com.tyrkanych.controller.MessagesController">
  <Separator orientation="VERTICAL"/>
  <VBox style="-fx-padding: 0 16 0 0;" prefWidth="260" spacing="16">
    <Label styleClass="label-title" text="Повідомлення"/>
    <ListView VBox.vgrow="ALWAYS" fx:id="chatList"/>
    <TextField promptText="🔍  Пошук чату" fx:id="chatSearch"/>
  </VBox>
  <VBox HBox.hgrow="ALWAYS" spacing="0">
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="chat-input-area">
      <StackPane
        style="-fx-background-color: linear-gradient(135deg,#C4B4E8,#9B7DD4); -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40;"
        alignment="CENTER">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"
          fx:id="chatInitial"/>
      </StackPane>
      <VBox spacing="2">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #2D2550;" fx:id="chatPartnerName"/>
        <Label style="-fx-font-size: 11px;" styleClass="label-muted" fx:id="chatPartnerStatus"/>
      </VBox>
    </HBox>
    <HBox alignment="CENTER" spacing="12" styleClass="chat-input-area">
      <Button style="-fx-font-size: 18px; -fx-min-width: 44; -fx-min-height: 44; -fx-background-radius: 50;" onAction="#sendMessage"
        styleClass="btn-primary"
        text="→"/>
      <TextField HBox.hgrow="ALWAYS" promptText="Написати повідомлення..." fx:id="messageInput"/>
    </HBox>
    <ScrollPane style="-fx-background-color: #F7F5FF; -fx-border-color: transparent;" VBox.vgrow="ALWAYS" fitToWidth="true"
      fx:id="chatScrollPane">
      <VBox style="-fx-padding: 20;" spacing="10" fx:id="messagesContainer">
        <Label style="-fx-padding: 40 0;" maxWidth="Infinity"
          styleClass="label-muted" text="Виберіть чат щоб почати спілкування ✦"/>
      </VBox>
    </ScrollPane>
  </VBox>
</HBox>