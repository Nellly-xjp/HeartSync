<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="0" styleClass="pane-root"
  stylesheets="@../styles/styles.css"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.tyrkanych.controller.MessagesController">

  <VBox prefWidth="260" spacing="16" style="-fx-padding: 0 16 0 0;">
    <Label styleClass="label-title" text="Повідомлення"/>
    <ListView fx:id="chatList" VBox.vgrow="ALWAYS"/>
    <TextField fx:id="chatSearch" promptText="🔍  Пошук чату"/>
  </VBox>

  <VBox HBox.hgrow="ALWAYS" spacing="0">
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="chat-input-area">
      <StackPane alignment="CENTER"
        style="-fx-background-color: #C4B4E8; -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40;">
        <Label fx:id="chatInitial"
          style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
      </StackPane>
      <VBox spacing="2">
        <Label fx:id="chatPartnerName" style="-fx-font-weight: bold;"/>
        <Label fx:id="chatPartnerStatus" styleClass="label-muted" style="-fx-font-size: 11px;"/>
      </VBox>
    </HBox>

    <ScrollPane fx:id="chatScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true"
      style="-fx-background-color: transparent; -fx-border-color: transparent;">
      <VBox fx:id="messagesContainer" spacing="10" style="-fx-padding: 20;">
        <Label styleClass="label-muted" text="Виберіть чат щоб почати спілкування ✦"
          style="-fx-padding: 40 0;" maxWidth="Infinity"/>
      </VBox>
    </ScrollPane>

    <HBox alignment="CENTER" spacing="12" styleClass="chat-input-area">
      <Button text="→" styleClass="btn-primary" onAction="#sendMessage"
        style="-fx-font-size: 18px; -fx-min-width: 44; -fx-min-height: 44; -fx-background-radius: 50;"/>
      <TextField fx:id="messageInput" HBox.hgrow="ALWAYS"
        promptText="Написати повідомлення..."/>
    </HBox>
  </VBox>
</HBox>