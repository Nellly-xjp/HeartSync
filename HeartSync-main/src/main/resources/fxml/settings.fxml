<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
  style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.tyrkanych.controller.SettingsController">

  <VBox spacing="20" style="-fx-padding: 0 0 24 0;">

    <Label text="Налаштування" styleClass="label-title"/>

    <!-- Тема -->
    <VBox styleClass="card" spacing="16">
      <Label text="🎨  ТЕМА ОФОРМЛЕННЯ"
        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7B72A8;"/>
      <Label text="Оберіть зручну тему для очей" styleClass="label-muted"/>
      <HBox spacing="12">
        <Button fx:id="btnLightTheme" text="☀️  Світла тема"
          styleClass="btn-secondary" onAction="#setLightTheme"
          prefWidth="160"/>
        <Button fx:id="btnDarkTheme" text="🌙  Темна тема"
          styleClass="btn-secondary" onAction="#setDarkTheme"
          prefWidth="160"/>
      </HBox>
      <Label fx:id="themeStatus" styleClass="label-muted"
        text="☀️ Зараз активна світла тема"/>
    </VBox>

    <!-- Уподобання -->
    <VBox styleClass="card" spacing="16">
      <Label text="🔍  УПОДОБАННЯ ПОШУКУ"
        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7B72A8;"/>
      <Label text="Хто тебе цікавить?" styleClass="label-muted"/>

      <VBox spacing="4">
        <Label text="СТАТЬ" styleClass="field-label"/>
        <ComboBox fx:id="prefGender" maxWidth="Infinity" promptText="Оберіть стать"/>
      </VBox>

      <HBox spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
          <Label text="ВІК ВІД" styleClass="field-label"/>
          <TextField fx:id="prefMinAge" promptText="18" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
          <Label text="ВІК ДО" styleClass="field-label"/>
          <TextField fx:id="prefMaxAge" promptText="60" maxWidth="Infinity"/>
        </VBox>
      </HBox>

      <VBox spacing="4">
        <Label text="МІСТО" styleClass="field-label"/>
        <TextField fx:id="prefCity" promptText="Будь-яке місто" maxWidth="Infinity"/>
      </VBox>

      <Button text="✓  Зберегти уподобання" styleClass="btn-primary"
        onAction="#savePreferences"/>
    </VBox>

    <!-- Сповіщення -->
    <VBox styleClass="card" spacing="16">
      <Label text="🔔  СПОВІЩЕННЯ"
        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7B72A8;"/>
      <CheckBox fx:id="notifyMatches" text="Нові збіги"/>
      <CheckBox fx:id="notifyMessages" text="Нові повідомлення"/>
      <Button text="✓  Зберегти" styleClass="btn-secondary" onAction="#savePrivacy"/>
    </VBox>

    <!-- Небезпечна зона -->
    <VBox styleClass="card" spacing="16">
      <Label text="⚠️  НЕБЕЗПЕЧНА ЗОНА"
        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #C44569;"/>
      <Label text="Після видалення всі дані будуть назавжди видалені."
        styleClass="label-muted" wrapText="true"/>
      <Button text="🗑️  Видалити акаунт" styleClass="btn-danger"
        onAction="#deleteAccount"/>
    </VBox>

    <Label fx:id="settingsStatus" wrapText="true"/>

  </VBox>
</ScrollPane>
